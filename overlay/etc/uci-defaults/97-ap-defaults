#!/bin/sh
# One-time defaults for this access point. uci-defaults run again after every sysupgrade, so a
# marker in /etc/config/ghupdate keeps them from overriding changes made later.

# Prometheus node exporter: serve metrics on the LAN (port 9100) instead of loopback only.
if [ "$(uci -q get ghupdate.main.exporter_defaults)" != 1 ] && uci -q get prometheus-node-exporter-lua.main >/dev/null; then
	uci set prometheus-node-exporter-lua.main.listen_interface='lan'
	uci commit prometheus-node-exporter-lua
	uci set ghupdate.main.exporter_defaults='1'
	uci commit ghupdate
fi

exit 0
