#!/bin/sh
# Join the existing LAN as a DHCP client instead of claiming OpenWrt's default 192.168.1.1
# and serving DHCP/RA. Acts only on a fresh default config, so it never overrides choices
# made later (uci-defaults run again after every sysupgrade).
[ "$(uci -q get network.lan.proto)" = "static" ] && [ "$(uci -q get network.lan.ipaddr)" = "192.168.1.1" ] || exit 0

uci set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.ip6assign
uci -q delete network.globals.ula_prefix

uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'

uci commit network
uci commit dhcp

/etc/init.d/dnsmasq disable
/etc/init.d/odhcpd disable

exit 0
