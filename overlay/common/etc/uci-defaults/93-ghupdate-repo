#!/bin/sh
# The build repo was renamed (openwrt-wax214v2 -> openwrt-home-aps); follow it. Only touches the
# old default, never a repo someone chose deliberately.
[ "$(uci -q get ghupdate.main.repo)" = "oliviacpu/openwrt-wax214v2" ] || exit 0
uci set ghupdate.main.repo='oliviacpu/openwrt-home-aps'
uci commit ghupdate
exit 0
