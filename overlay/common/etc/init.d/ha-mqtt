#!/bin/sh /etc/rc.common
# Publishes access-point health to Home Assistant over MQTT (see /usr/sbin/ha-mqtt).
# Does nothing until /etc/config/ha_mqtt has enabled=1 and a broker host.
START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get ha_mqtt.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/ha-mqtt run
	procd_set_param respawn 3600 30 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ha_mqtt
}
