#!/bin/sh
# ha-mqtt: publish access-point health to Home Assistant over MQTT (HA's native MQTT discovery).
# Shared by the Beryl and the Netgear. Settings come from /etc/config/ha_mqtt; the broker credentials
# live only on the device. Bands are found through netifd and phy capabilities, so ifnames don't matter.
#
#   ha-mqtt run        loop forever (procd: /etc/init.d/ha-mqtt)
#   ha-mqtt dry-run    print the discovery configs and one state message, publish nothing
#   ha-mqtt listen     commands from HA (procd, second instance): firmware installs, LED lights,
#                      radio / SSID switches, transmit power, reboot and restart buttons
#
# Every sensor reads one key from a single JSON state topic, and has expire_after = 3 intervals.
# Missing or implausible data (no 5 GHz AP, no fan, a sensor that isn't ready) is published as null
# and shows as unknown in HA. Besides the state topic: <prefix>/<node>/availability (online/offline,
# the listener's MQTT will), /stations (per-station signal and rates), /system (top processes and
# the last log lines, every 5 cycles) and /event/new_device.

cfg() { uci -q get "ha_mqtt.main.$1"; }
INTERVAL=$(cfg interval); INTERVAL=${INTERVAL:-60}
DPREFIX=$(cfg discovery_prefix); DPREFIX=${DPREFIX:-homeassistant}
TPREFIX=$(cfg topic_prefix); TPREFIX=${TPREFIX:-openwrt-ap}
HOST_NAME=$(uci -q get system.@system[0].hostname)
NAME=$(cfg name); NAME=${NAME:-$HOST_NAME}
NODE=$(cfg node_id); NODE=${NODE:-$(echo "$NAME" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_' | sed 's/__*/_/g; s/^_//; s/_$//')}
STATE_TOPIC="$TPREFIX/$NODE/state"
AVAIL="$TPREFIX/$NODE/availability"
STA_TOPIC="$TPREFIX/$NODE/stations"
SYS_TOPIC="$TPREFIX/$NODE/system"
EVENT_TOPIC="$TPREFIX/$NODE/event/new_device"
SETP="$TPREFIX/$NODE/set/"      # + radio_2g|radio_5g|ssid_2g|ssid_5g|tx_power_2g|tx_power_5g
BTNP="$TPREFIX/$NODE/button/"   # + reboot|restart_networking|restart_wifi
CACHE=/tmp/ha-mqtt/run          # counters between cycles (CPU, traffic, boot time); dry-run uses its own
KNOWN=/etc/ha-mqtt/known-macs   # every station MAC seen, for the new-device event (kept across updates)

# ---------- helpers ----------
num() { [ -n "$1" ] && echo "$1" || echo null; }                # JSON number or null
# mt7915 hwmon reads 0-1 degC until the radio's sensor is ready, so only 10-130 degC counts as real.
temp() { awk -v t="$1" 'BEGIN { if (t ~ /^-?[0-9.]+$/ && t + 0 >= 10 && t + 0 <= 130) print t; else print "null" }'; }
# usteer's channel load comes from the channel survey, where mt7915 reports busy time > active time
# (seen: 643490 %), so only an integer 0-100 counts.
pct() { case "$1" in ''|*[!0-9]*) echo null ;; *) [ "$1" -le 100 ] && echo "$1" || echo null ;; esac; }
# JSON-escape: strip control characters, escape \ and ". Needed because some values come off the
# wire (LLDP/CDP names advertised by other devices) and must not be able to break or inject JSON.
esc() { printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
str() { [ -n "$1" ] && printf '"%s"' "$(esc "$1")" || echo null; }   # JSON string or null
milli() { [ -r "$1" ] && awk '{ printf "%.1f", $1 / 1000 }' "$1"; }   # millidegree file -> degrees
radio() { uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.band='$1'$/\1/p" | head -n 1; }
aps() {  # access-point ifnames on band $1 (2g/5g), from netifd
	r=$(radio "$1"); [ -n "$r" ] || return
	ubus call network.wireless status | jsonfilter -e "@.$r.interfaces[@.config.mode=\"ap\"].ifname" 2>/dev/null
}
phy_band() {  # 2g or 5g for a phy (phy0, phy1)
	iw phy "$1" info 2>/dev/null | grep -qE ' 24[0-9]{2}(\.[0-9])? MHz' && echo 2g || echo 5g   # newer iw prints "2412.0 MHz"
}
hwmon_temp() {  # temperature of the hwmon device whose name matches $1
	for h in /sys/class/hwmon/hwmon*; do
		case "$(cat "$h/name" 2>/dev/null)" in $1) milli "$h/temp1_input"; return ;; esac
	done
}
wifi_temp() {  # mt7915-style per-phy hwmon (mt7915_phyN), mapped to band $1
	for h in /sys/class/hwmon/hwmon*; do
		n=$(cat "$h/name" 2>/dev/null)
		case "$n" in *_phy[0-9]) [ "$(phy_band "${n##*_}")" = "$1" ] && { milli "$h/temp1_input"; return; } ;; esac
	done
}
fan_rpm() {
	for h in /sys/class/hwmon/hwmon*; do
		[ "$(cat "$h/name" 2>/dev/null)" = pwmfan ] && { cat "$h/fan1_input"; return; }
	done
}
usteer_band() {  # field $2 (load, noise, n_assoc) of the usteer node on band $1
	ubus call usteer local_info 2>/dev/null | jsonfilter -e '@[*]' 2>/dev/null | while read -r node; do
		f=$(echo "$node" | jsonfilter -e '@.freq' 2>/dev/null); [ -n "$f" ] || continue
		b=5g; [ "$f" -lt 3000 ] && b=2g
		[ "$b" = "$1" ] && { echo "$node" | jsonfilter -e "@.$2" 2>/dev/null; break; }
	done
}
usteer_roams() {  # total roam_events.$1 (source = steered away, target = arrived) across local nodes
	ubus call usteer local_info 2>/dev/null | jsonfilter -e "@[*].roam_events.$1" 2>/dev/null | awk '{ s += $1 } END { if (NR) print s }'
}
tx_pct() {  # percent of tx packets that were retries ($2=retries) or finally dropped ($2=failed), band $1
	# mt76 (mt7915/mt7981/mt7996) counts tx_failed = tx_retries + final drops (mt7915/mac.c, tx-free
	# path), so on those drivers the drops are failed - retries. Other drivers count drops only.
	for i in $(aps "$1"); do
		d=$(readlink "/sys/class/net/$i/device/driver" 2>/dev/null)
		case "${d##*/}" in mt79*|mt76*) mt=1 ;; *) mt=0 ;; esac
		iw dev "$i" station dump 2>/dev/null | awk -v mt=$mt '
			/tx packets:/ { p += $3 } /tx retries:/ { r += $3 } /tx failed:/ { f += $3 }
			END { if (mt) f -= r; if (f < 0) f = 0; print p + 0, r + 0, f + 0 }'
	done | awk -v k="$2" '{ p += $1; r += $2; f += $3 } END { if (p > 0) printf "%.1f", ((k == "retries") ? r : f) * 100 / p }'
}
usteer_peers() {  # distinct remote usteer hosts this AP sees (one host has a node per radio, "<ip>#<node>")
	ubus call usteer remote_info 2>/dev/null | sed -n 's/^[[:space:]]*"\([^"]*#[^"]*\)": {$/\1/p' | cut -d'#' -f1 | sort -u | wc -l
}
lldp_neighbors() {  # every LLDP/CDP neighbour, "<name> <port> (<via>)" joined by "; ". CDP frames are
	# forwarded by plain bridges, so a far device can show up next to the real uplink switch.
	command -v lldpcli >/dev/null 2>&1 || return
	lldpcli -f keyvalue show neighbors 2>/dev/null | awk -F= '
		function flush() { if (name != "") { out = out (out == "" ? "" : "; ") name " " port " (" via ")" } name = port = "" }
		/\.via=/ { flush(); via = $2 } /\.chassis\.name=/ { name = $2 } /\.port\.descr=/ { port = $2 }
		END { flush(); printf "%s", out }'
}
firmware_json() {  # this image's updates (ghupdate) for the MQTT update entity
	command -v ghupdate >/dev/null 2>&1 || return
	GHU_SERIAL= GHU_TAG= GHU_OPENWRT=; [ -r /etc/ghupdate/build ] && . /etc/ghupdate/build
	ST= UA= LS= LO= LU= MSG= BLK=
	eval "$(ghupdate status 2>/dev/null | jsonfilter -e 'ST=@.state' -e 'UA=@.update_available' -e 'LS=@.latest.serial' \
		-e 'LO=@.latest.openwrt' -e 'LU=@.latest.url' -e 'MSG=@.message' -e 'BLK=@.auto.blocked')"
	# "<OpenWrt version>-b<n>", like the release tags: the OpenWrt release the image is based on, and
	# this repo's build (needed: two builds of one OpenWrt release must differ for HA to offer the update).
	inst="${GHU_OPENWRT:-$(. /etc/openwrt_release; echo "${DISTRIB_RELEASE:-?}")}-b${GHU_SERIAL:-?}"; latest=$inst
	case "$UA" in true|1) [ -n "$LS" ] && latest="${LO:-${GHU_OPENWRT:-?}}-b$LS" ;; esac
	prog=false; case "$ST" in downloading|ready|installing) prog=true ;; esac
	sum=${MSG:-${ST:-unknown}}; [ -n "$BLK" ] && sum="$sum. Automatic installs on hold: $BLK"
	case "$ST" in ''|unknown) sum="Checking for updates" ;; esac   # just booted: ghupdate hasn't checked yet
	sum=$(printf '%s' "$sum" | cut -c1-250)   # HA's release_summary limit is 255
	# HA rejects the whole payload if release_url is null ("invalid url"). Before ghupdate's first
	# check (just after boot) latest.url is empty: link the installed build's own release then, since
	# omitting the key would leave HA showing the previous build's link.
	if [ -z "$LU" ] && [ -n "${GHU_TAG:-}" ] && [ "$GHU_TAG" != unknown ]; then
		repo=$(uci -q get ghupdate.main.repo); LU="https://github.com/${repo:-oliviacpu/openwrt-home-aps}/releases/tag/$GHU_TAG"
	fi
	url=; [ -n "$LU" ] && url=$(printf ',"release_url":"%s"' "$(esc "$LU")")
	printf '{"installed_version":"%s","latest_version":"%s","title":"%s image","in_progress":%s%s,"release_summary":"%s"}\n' \
		"$(esc "$inst")" "$(esc "$latest")" "$(esc "$NAME")" "$prog" "$url" "$(esc "$sum")"
}
# HA-triggered installs need a ghupdate with `remote-install` (rate limit, newer-only, inhibit hooks,
# signature + checksum + sysupgrade -T). Detected by reading the script, never by running it:
# `remote-install` takes no arguments and any call is a real install request. Without it, HA's
# update entity stays read-only.
remote_ok() { g=$(command -v ghupdate 2>/dev/null) && grep -q '^[[:space:]]*remote-install)' "$g"; }
signals() {  # "dBm MAC" for every station on this AP's access points (same as ha-wifi's stations)
	for i in $(aps 2g) $(aps 5g); do iwinfo "$i" assoclist 2>/dev/null; done |
	awk '/^[0-9A-Fa-f][0-9A-Fa-f]:/ { for (k = 2; k < NF; k++) if ($(k+1) == "dBm") { print $k, $1; break } }'; }
uplink() { for p in lan eth0; do [ -r "/sys/class/net/$p/speed" ] && { echo "$p"; return; }; done; }
flash() {  # "<free MB> <use %>" of the writable overlay (where settings and installed extras live)
	df -Pk /overlay 2>/dev/null | awk 'NR == 2 && $4 ~ /^[0-9]+$/ { sub(/%$/, "", $5); print int($4 / 1024), $5 }'
}
tailnet() {  # sets TS_* from `tailscale status --json`; all empty when tailscale or tailscaled is absent.
	# jsonfilter exports arrays as their indexes, so array elements are read with [*].
	TS_STATE= TS_IP= TS_PEERS= TS_HEALTH= TS_EXIT=
	command -v tailscale >/dev/null 2>&1 || return 0
	ts=$(tailscale status --json 2>/dev/null); [ -n "$ts" ] || return 0
	TS_STATE=$(jsonfilter -s "$ts" -e '@.BackendState' 2>/dev/null)
	TS_IP=$(jsonfilter -s "$ts" -e '@.Self.TailscaleIPs[*]' 2>/dev/null | grep -v : | head -n 1)
	TS_PEERS=$(jsonfilter -s "$ts" -e '@.Peer[*].Online' 2>/dev/null | grep -c '^true$')
	TS_HEALTH=$(jsonfilter -s "$ts" -e '@.Health[*]' 2>/dev/null | awk '{ printf "%s%s", (NR > 1 ? "; " : ""), $0 }' | cut -c1-250)
	TS_EXIT=$(jsonfilter -s "$ts" -e '@.ExitNodeStatus.Online' 2>/dev/null)
}
bool() { case "$1" in '') echo null ;; true|1) echo true ;; *) echo false ;; esac; }   # JSON boolean or null
isnum() { case "$1" in ''|*[!0-9.-]*|*.*.*|?*-*|-|.) echo null ;; *) echo "$1" ;; esac; }   # untrusted text -> JSON number or null

# ---------- system, radios, ports, stations ----------
# What HA's openwrt (ubus) integration used to read, so that integration can go.
band_oid() { [ "$1" = 2g ] && echo 2_4_ghz || echo 5_ghz; }   # entity-id part, as HA's openwrt integration named them
band_name() { [ "$1" = 2g ] && echo "2.4 GHz" || echo "5 GHz"; }
bands() { for b in 2g 5g; do [ -n "$(radio $b)" ] && echo $b; done; }   # bands this AP has a radio for
ap_section() {  # the first access-point wifi-iface on band $1's radio (the SSID switch)
	r=$(radio "$1"); [ -n "$r" ] || return
	for s in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.device='$r'$/\1/p"); do
		[ "$(uci -q get "wireless.$s.mode")" = ap ] && { echo "$s"; return; }
	done
}
uci_on() { [ -n "$1" ] || { echo null; return; }; [ "$(uci -q get "wireless.$1.disabled")" = 1 ] && echo false || echo true; }
live() {  # live value from band $1's first AP interface: $2 = channel | txpower (dBm)
	i=$(aps "$1" | head -n 1); [ -n "$i" ] || return
	case "$2" in
		channel) iwinfo "$i" info 2>/dev/null | sed -n 's/.*Channel: \([0-9][0-9]*\) .*/\1/p' | head -n 1 ;;
		txpower) iwinfo "$i" info 2>/dev/null | sed -n 's/.*Tx-Power: \([0-9][0-9]*\) dBm.*/\1/p' | head -n 1 ;;
	esac
}
txpower_max() {  # highest transmit power (dBm) band $1's radio offers; empty when its AP is down
	i=$(aps "$1" | head -n 1); [ -n "$i" ] || return
	iwinfo "$i" txpowerlist 2>/dev/null | awk '{ for (k = 1; k < NF; k++) if (tolower($(k+1)) == "dbm" && $k ~ /^[0-9]+$/) v = $k } END { if (v != "") print v }'
}
ports() {  # "<ifname> <entity-id part> <name>" per Ethernet port, named like HA's openwrt integration did
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		glinet,gl-mt3000) echo "eth0 2_5g_port 2.5G port"; echo "eth1 1g_port 1G port" ;;
		*) for p in lan eth0; do [ -e "/sys/class/net/$p" ] && { echo "$p ethernet Ethernet"; return; }; done ;;
	esac
}
cpu_pct() {  # busy % of all CPUs since the previous cycle (null on the first)
	set -- $(head -n 1 /proc/stat); shift
	t=$(( $1 + $2 + $3 + $4 + ${5:-0} + ${6:-0} + ${7:-0} + ${8:-0} )); i=$(( $4 + ${5:-0} ))
	p=$(cat "$CACHE/cpu" 2>/dev/null); echo "$t $i" > "$CACHE/cpu"
	awk -v t="$t" -v i="$i" -v p="$p" 'BEGIN { if (split(p, a, " ") == 2 && t > a[1] && i >= a[2]) printf "%.1f", (t - a[1] - (i - a[2])) * 100 / (t - a[1]); else print "null" }'
}
mem_pct() { awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { if (t > 0 && a != "") printf "%.1f", (t - a) * 100 / t; else print "null" }' /proc/meminfo; }
last_boot() {  # boot time, UTC ISO. Kept unless it moves more than 60 s (an NTP step), so the second
	# of jitter in now - uptime doesn't change the state every cycle.
	[ "$(date +%Y)" -ge 2025 ] || return 0   # clock not set yet
	b=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) )); o=$(cat "$CACHE/boot" 2>/dev/null)
	if [ -z "$o" ] || [ $((b - o)) -gt 60 ] || [ $((o - b)) -gt 60 ]; then echo "$b" > "$CACHE/boot"; o=$b; fi
	date -u -d "@$o" +%Y-%m-%dT%H:%M:%S+00:00
}
public_ip() {  # travel router only (where /etc/beryl-mode exists): its internet address, checked every 30 min
	[ -d /etc/beryl-mode ] || return 0
	f=$CACHE/public_ip; now=$(date +%s)
	if [ ! -e "$f" ] || [ $((now - $(date -r "$f" +%s 2>/dev/null || echo 0))) -ge 1800 ]; then
		ip=$(uclient-fetch -q -T 5 -O - https://api.ipify.org 2>/dev/null | head -c 64)
		case "$ip" in *[!0-9a-fA-F.:]*) ip= ;; esac
		echo "$ip" > "$f"
	fi
	cat "$f"
}
reboot_needed() { [ -e /tmp/.reboot-needed ] || [ -e /var/run/reboot-required ] && echo true || echo false; }
devices_seen() { brctl showmacs br-lan 2>/dev/null | awk 'NR > 1 && $3 == "no"' | wc -l; }   # MACs the LAN bridge has learned
counters() {  # "<id> <rx bytes> <tx bytes>" per measured link; "x" where a link has no counters now
	ports | while read -r ifn oid name; do
		echo "port_$oid $(cat "/sys/class/net/$ifn/statistics/rx_bytes" 2>/dev/null || echo x) $(cat "/sys/class/net/$ifn/statistics/tx_bytes" 2>/dev/null || echo x)"
	done
	for b in $(bands); do   # every band with a radio, so its keys exist (null) while its AP is off
		l=$(aps $b)
		[ -n "$l" ] || { echo "ap_$b x x"; continue; }
		for i in $l; do echo "$(cat "/sys/class/net/$i/statistics/rx_bytes" 2>/dev/null || echo 0) $(cat "/sys/class/net/$i/statistics/tx_bytes" 2>/dev/null || echo 0)"; done |
			awk -v id="ap_$b" '{ r += $1; t += $2 } END { printf "%s %.0f %.0f\n", id, r, t }'
	done
	command -v tailscale >/dev/null 2>&1 && echo "tailscale $(cat /sys/class/net/tailscale0/statistics/rx_bytes 2>/dev/null || echo x) $(cat /sys/class/net/tailscale0/statistics/tx_bytes 2>/dev/null || echo x)"
}
rates() {  # JSON members "traffic_<id>_rx|tx" in Mbit/s since the previous cycle; null on the first
	# cycle, after a counter reset, or for a link without counters
	now=$(date +%s); cur=$(counters); prev=$(cat "$CACHE/counters" 2>/dev/null)
	{ echo "ts $now"; echo "$cur"; } > "$CACHE/counters"
	{ echo "$prev" | sed 's/^/old /'; echo "now $now"; echo "$cur" | sed 's/^/new /'; } | awk '
		function r(o, c) { if (dt <= 0 || o !~ /^[0-9]+$/ || c !~ /^[0-9]+$/ || c + 0 < o + 0) return "null"; return sprintf("%.2f", (c - o) * 8 / dt / 1000000) }
		$1 == "old" && $2 == "ts" { ots = $3; next }
		$1 == "old" && NF == 4 { orx[$2] = $3; otx[$2] = $4; next }
		$1 == "now" { nts = $2; next }
		$1 == "new" && NF == 4 { ids[++n] = $2; nrx[$2] = $3; ntx[$2] = $4 }
		END { dt = (ots == "" ? 0 : nts - ots)
			for (k = 1; k <= n; k++) { id = ids[k]; printf "\"traffic_%s_rx\":%s,\"traffic_%s_tx\":%s,", id, r(orx[id], nrx[id]), id, r(otx[id], ntx[id]) } }'
}
stations() {  # "<mac> <band> <signal dBm> <tx Mbit/s> <rx Mbit/s>" per associated station, MAC lower-case
	for b in $(bands); do for i in $(aps $b); do iwinfo "$i" assoclist 2>/dev/null | awk -v b=$b '
		function out() { if (m != "") print m, b, (s == "" ? "-" : s), (tx == "" ? "-" : tx), (rx == "" ? "-" : rx) }
		/^[0-9A-Fa-f][0-9A-Fa-f](:[0-9A-Fa-f][0-9A-Fa-f])+ / { out(); m = tolower($1); s = tx = rx = ""
			for (k = 2; k < NF; k++) if ($(k+1) == "dBm") { s = $k; break }; next }
		$1 == "RX:" { rx = $2 } $1 == "TX:" { tx = $2 }
		END { out() }'; done; done
}
stations_json() {  # the stations file as {"<mac>":{"band":..,"signal":..,"tx_mbps":..,"rx_mbps":..},...}
	printf '{'
	sep=
	while read -r mac band sig tx rx; do
		case "$mac" in [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;; *) continue ;; esac
		printf '%s"%s":{"band":"%s","signal":%s,"tx_mbps":%s,"rx_mbps":%s}' "$sep" "$mac" "$band" "$(isnum "$sig")" "$(isnum "$tx")" "$(isnum "$rx")"
		sep=,
	done < "$1"
	printf '}\n'
}
random_mac() { case "$1" in ?[26ae]:*) return 0 ;; *) return 1 ;; esac; }   # locally administered: a private, changing address
system_json() {  # top 10 processes by CPU, the process count and the last 20 log lines (printable ASCII only)
	# Quotes and backslashes are dropped (not escaped): busybox awk's gsub eats the backslash of \".
	top -bn1 2>/dev/null | tr -cd '\n\040-\176' | tr -d '"\\' | awk '
		/^ *PID +PPID/ { f = 1; next }
		f && NF >= 8 && $1 ~ /^[0-9]+$/ { n++; c = $8; for (k = 9; k <= NF; k++) c = c " " $k; c = substr(c, 1, 120)
			u = $3; cpu = $7; sub(/%$/, "", cpu); if (cpu !~ /^[0-9]+$/) cpu = 0
			printf "%d\t{\"pid\":%d,\"user\":\"%s\",\"cpu\":%d,\"command\":\"%s\"}\n", cpu, $1, u, cpu, c }' |
		sort -rn | head -n 10 | cut -f2- > "$CACHE/top"
	count=$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)
	logread -l 20 2>/dev/null | tr -cd '\n\040-\176' | cut -c1-250 > "$CACHE/log"
	printf '{"process_count":%s,"processes":[' "$count"
	awk '{ printf "%s%s", (NR > 1 ? "," : ""), $0 }' "$CACHE/top"
	printf '],"log_last":%s,"logs":[' "$(str "$(tail -n 1 "$CACHE/log")")"
	sed 's/\\/\\\\/g; s/"/\\"/g' "$CACHE/log" | awk '{ printf "%s\"%s\"", (NR > 1 ? "," : ""), $0 }'   # escaped like esc()
	printf ']}\n'
}

# ---------- LEDs (HA lights) ----------
# The allow-list is every LED in /sys/class/leds with a plain name, read at startup; commands can
# only name one of those. Changes made from HA last until the next reboot, which brings back the
# boot-time behaviour (the "Default" effect restores it without a reboot).
LEDD=/sys/class/leds
led_list() {  # "slug name" per LED
	for d in "$LEDD"/*; do
		[ -e "$d/brightness" ] || continue
		n=${d##*/}
		case "$n" in '' | *[!A-Za-z0-9:_.+-]* | *..*) continue ;; esac
		echo "$(echo "$n" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_' | sed 's/__*/_/g; s/^_//; s/_$//') $n"
	done
}
led_name() {  # "Power light (blue)", "2.4 GHz light", "5 GHz activity light", ...
	n=$1; col=; fn=$n
	case "$n" in *:*) col=${n%%:*}; fn=${n#*:} ;; esac
	case "$fn" in
		wlan-2ghz | wlan2g) echo "2.4 GHz light" ;;
		wlan-5ghz | wlan5g) echo "5 GHz light" ;;
		*phy[0-9]*) p=${fn##*phy}; p=phy${p%%[!0-9]*}
			[ "$(phy_band "$p")" = 2g ] && echo "2.4 GHz activity light" || echo "5 GHz activity light" ;;
		*) f=$(echo "$fn" | sed 's/[-_]/ /g'); f="$(printf '%s' "$f" | cut -c1 | tr 'a-z' 'A-Z')$(printf '%s' "$f" | cut -c2-)"
			[ -n "$col" ] && echo "$f light ($col)" || echo "$f light" ;;
	esac
}
led_trig() { sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$LEDD/$1/trigger" 2>/dev/null; }
led_effects() {  # "Default" (as booted) + the triggers that work without extra parameters
	echo Default
	tr ' ' '\n' < "$LEDD/$1/trigger" | tr -d '[]' | grep -vxE 'none|netdev|pattern|usbport|oneshot|transient|kbd-.*' | grep . | head -n 30
}
led_snapshot() {  # each LED's boot-time behaviour, recorded once per boot, for "Default"
	mkdir -p /tmp/ha-mqtt/led-default
	led_list | while read -r slug n; do
		f=/tmp/ha-mqtt/led-default/$slug; [ -e "$f" ] && continue
		# Per-process temp name (run and listen both get here at start); the group must end true,
		# or a failing last `[ -r ]` would skip the mv and the snapshot would be retaken every start.
		{ echo "trigger=$(led_trig "$n")"; echo "brightness=$(cat "$LEDD/$n/brightness")"
		  for a in device_name link rx tx interval delay_on delay_off; do
			[ -r "$LEDD/$n/$a" ] && echo "$a=$(cat "$LEDD/$n/$a")"
		  done; true; } > "$f.$$" && mv "$f.$$" "$f"
	done
}
led_restore() {  # $1 name, $2 slug: back to the recorded boot-time behaviour
	f=/tmp/ha-mqtt/led-default/$2; d=$LEDD/$1; [ -r "$f" ] || return 1
	t=$(sed -n 's/^trigger=//p' "$f")
	echo none > "$d/trigger"
	if [ "$t" = none ]; then
		sed -n 's/^brightness=//p' "$f" > "$d/brightness"
	else
		cat "$d/max_brightness" > "$d/brightness"   # a trigger blinks at the brightness it starts with
		echo "$t" > "$d/trigger"
		for a in device_name interval delay_on delay_off link rx tx; do
			v=$(sed -n "s/^$a=//p" "$f"); [ -n "$v" ] && [ -w "$d/$a" ] && echo "$v" > "$d/$a" 2>/dev/null
		done
	fi
}
led_state() {  # $1 name, $2 slug: state JSON for HA's json-schema light
	d=$LEDD/$1; t=$(led_trig "$1"); b=$(cat "$d/brightness" 2>/dev/null); m=$(cat "$d/max_brightness" 2>/dev/null)
	dt=$(sed -n 's/^trigger=//p' "/tmp/ha-mqtt/led-default/$2" 2>/dev/null)
	mode=onoff; [ "${m:-1}" -gt 1 ] && mode=brightness
	eff=
	if [ -n "$t" ] && [ "$t" != none ]; then st=ON; bb=$m; [ "$t" = "$dt" ] && eff=Default || eff=$t
	else bb=${b:-0}; [ "$bb" -gt 0 ] && st=ON || st=OFF; fi
	printf '{"state":"%s","color_mode":"%s"' "$st" "$mode"
	[ "$mode" = brightness ] && printf ',"brightness":%s' "${bb:-0}"
	[ -n "$eff" ] && printf ',"effect":"%s"' "$(esc "$eff")"
	printf '}\n'
}
led_publish() {  # publish each LED's state when it changed (or always, with $1 = 1)
	mkdir -p /tmp/ha-mqtt/led-state
	led_list | while read -r slug n; do
		j=$(led_state "$n" "$slug"); c=/tmp/ha-mqtt/led-state/$slug
		[ "$1" = 1 ] || [ "$j" != "$(cat "$c" 2>/dev/null)" ] || continue
		pub "$TPREFIX/$NODE/led/$slug/state" "$j" retain && echo "$j" > "$c"
	done
}
led_command() {  # $1 slug (from the topic), $2 JSON from HA: {"state":"ON|OFF","brightness":N,"effect":"..."}
	n=$(echo "$LEDS" | awk -v s="$1" '$1 == s { print $2; exit }')
	[ -n "$n" ] || { logger -t ha-mqtt "ignored an LED command for an unknown LED"; return; }
	d=$LEDD/$n
	s=$(jsonfilter -s "$2" -e '@.state' 2>/dev/null); b=$(jsonfilter -s "$2" -e '@.brightness' 2>/dev/null)
	e=$(jsonfilter -s "$2" -e '@.effect' 2>/dev/null)
	m=$(cat "$d/max_brightness" 2>/dev/null); m=${m:-1}
	case "$s" in
		OFF) echo none > "$d/trigger"; echo 0 > "$d/brightness" ;;
		ON)
			if [ -n "$e" ]; then
				if [ "$e" = Default ]; then led_restore "$n" "$1"
				elif led_effects "$n" | grep -qxF -- "$e"; then echo none > "$d/trigger"; echo "$m" > "$d/brightness"; echo "$e" > "$d/trigger"
				else logger -t ha-mqtt "ignored an unknown effect for LED $n"; return; fi
			elif [ -n "$b" ]; then
				case "$b" in *[!0-9]* | '') logger -t ha-mqtt "ignored a bad brightness for LED $n"; return ;; esac
				[ "$b" -gt "$m" ] && b=$m
				echo none > "$d/trigger"; echo "$b" > "$d/brightness"
			elif [ "$(led_trig "$n")" = none ] && [ "$(cat "$d/brightness")" -eq 0 ]; then
				echo "$m" > "$d/brightness"
			fi ;;
		*) logger -t ha-mqtt "ignored an LED command without a valid state"; return ;;
	esac
	logger -t ha-mqtt "LED $n: $s${e:+, effect $e}${b:+, brightness $b} (from Home Assistant)"
	mkdir -p /tmp/ha-mqtt/led-state
	j=$(led_state "$n" "$1"); pub "$TPREFIX/$NODE/led/$1/state" "$j" retain && echo "$j" > "/tmp/ha-mqtt/led-state/$1"
}

# ---------- Wi-Fi switches, transmit power, buttons (HA commands) ----------
wake() {  # make the publisher send its state now (after $1 s). Only signals a live `ha-mqtt run`:
	# USR1 would end any other process.
	( sleep "${1:-0}"; p=$(cat /tmp/ha-mqtt/run.pid 2>/dev/null)
	  [ -n "$p" ] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'ha-mqtt run' && kill -USR1 "$p" ) >/dev/null 2>&1 &
}
wifi_command() {  # $1 radio_<band> | ssid_<band> | tx_power_<band>, $2 payload (ON/OFF, or dBm)
	b=${1##*_}; what=${1%_*}
	case "$b" in 2g|5g) ;; *) logger -t ha-mqtt "ignored a Wi-Fi command on a bad topic"; return ;; esac
	r=$(radio "$b"); [ -n "$r" ] || { logger -t ha-mqtt "ignored a Wi-Fi command for a band without a radio"; return; }
	case "$what" in
		radio|ssid)
			case "$2" in ON) v=0 ;; OFF) v=1 ;; *) logger -t ha-mqtt "ignored a Wi-Fi switch command without ON/OFF"; return ;; esac
			if [ "$what" = radio ]; then sec=$r; label="$(band_name "$b") radio"
			else sec=$(ap_section "$b"); [ -n "$sec" ] || { logger -t ha-mqtt "ignored an SSID command: no access point on $b"; return; }
				label="$(band_name "$b") $(uci -q get "wireless.$sec.ssid")"; fi
			cur=$(uci -q get "wireless.$sec.disabled"); cur=${cur:-0}   # unset means enabled
			[ "$cur" = "$v" ] || { uci set "wireless.$sec.disabled=$v"; uci commit wireless; wifi reload; }
			logger -t ha-mqtt "$label: $2 (from Home Assistant)" ;;
		tx_power)
			p=${2%.0}
			case "$p" in ''|*[!0-9]*) logger -t ha-mqtt "ignored a transmit power that isn't a whole number"; return ;; esac
			max=$(txpower_max "$b"); max=${max:-30}
			[ "$p" -ge 1 ] && [ "$p" -le "$max" ] || { logger -t ha-mqtt "ignored a transmit power outside 1-$max dBm"; return; }
			uci set "wireless.$r.txpower=$p"; uci commit wireless; wifi reload
			logger -t ha-mqtt "$(band_name "$b") transmit power: $p dBm (from Home Assistant)" ;;
		*) logger -t ha-mqtt "ignored an unknown Wi-Fi command"; return ;;
	esac
	wake 5   # the radios take a few seconds to come back with the new setting
}
button_command() {  # $1 reboot | restart_networking | restart_wifi, $2 must be PRESS; one press per 5 min each
	[ "$2" = PRESS ] || { logger -t ha-mqtt "ignored a button command with an unexpected payload"; return; }
	case "$1" in reboot|restart_networking|restart_wifi) ;; *) logger -t ha-mqtt "ignored an unknown button"; return ;; esac
	now=$(date +%s); f=/tmp/ha-mqtt/last-$1; last=$(cat "$f" 2>/dev/null || echo 0)
	[ $((now - last)) -ge 300 ] || { logger -t ha-mqtt "Home Assistant $1 ignored: at most one per 5 min"; return; }
	echo "$now" > "$f"
	logger -t ha-mqtt "$1 (from Home Assistant)"
	case "$1" in   # detached, so this listener answers before the restart cuts it off
		reboot) ( sleep 2; reboot ) >/dev/null 2>&1 & ;;
		restart_networking) ( sleep 2; /etc/init.d/network restart ) >/dev/null 2>&1 & ;;
		restart_wifi) ( sleep 2; wifi; ) >/dev/null 2>&1 & wake 15 ;;
	esac
}

# ---------- stations: new-device events, per-device sensors ----------
new_devices() {  # an HA event for each station MAC this AP has never seen; the first run only records them
	s=$CACHE/stations; [ -s "$s" ] || return 0
	mkdir -p "${KNOWN%/*}"
	if [ ! -e "$KNOWN" ]; then cut -d' ' -f1 "$s" | sort -u > "$KNOWN"; return 0; fi
	while read -r mac band sig tx rx; do
		grep -qxF "$mac" "$KNOWN" && continue
		rnd=false; random_mac "$mac" && rnd=true
		pub "$EVENT_TOPIC" "$(printf '{"event_type":"new_device","mac":"%s","band":"%s","signal":%s,"random_mac":%s}' "$mac" "$band" "$(isnum "$sig")" "$rnd")" &&
			echo "$mac" >> "$KNOWN"
	done < "$s"
	[ "$(wc -l < "$KNOWN")" -le 1000 ] || { tail -n 500 "$KNOWN" > "$KNOWN.new" && mv "$KNOWN.new" "$KNOWN"; }
}
announce_stations() {  # discovery for stations not announced yet; $1 = 1 re-announces every current one
	[ "$(cfg station_sensors)" = 1 ] || return 0
	a=$CACHE/stations-announced; [ "$1" = 1 ] && : > "$a"; touch "$a"
	cut -d' ' -f1 "$CACHE/stations" | sort -u | while read -r mac; do
		grep -qxF "$mac" "$a" && continue
		f=$(echo "$mac" | station_discovery | while IFS="$(printf '\t')" read -r t p; do pub "$t" "$p" retain || echo x; done | wc -l)
		[ "$f" -eq 0 ] && echo "$mac" >> "$a"
	done
}

# ---------- one state message ----------
state() {
	up=$(uplink)
	# One iwinfo pass feeds all three, so count, weakest and list agree. NF skips the empty line
	# that echo "" prints with no stations (awk would compare "" < -70 as strings: true).
	sig=$(signals)
	weak=$(echo "$sig" | awk 'NF && $1 < -70' | wc -l)
	weakest=$(echo "$sig" | awk 'NF' | sort -n | head -n 1 | cut -d' ' -f1)
	# "MAC=dBm,..." below -70 dBm, weakest first, at most 8 (ha-wifi weaknames' format; 8 x 21 chars
	# fits HA's 255-char state limit). HA's template helpers turn the MACs into device names.
	weakmacs=$(echo "$sig" | awk 'NF && $1 < -70' | sort -n | head -n 8 | awk '{ printf "%s%s=%s", (NR > 1 ? "," : ""), $2, $1 }')
	mode=; [ -r /etc/beryl-mode/current ] && mode=$(cat /etc/beryl-mode/current)
	sw=$(sed -n 's/.*|mode *) in *\([a-z]*\).*/\1/p' /sys/kernel/debug/gpio 2>/dev/null | head -n 1)
	. /etc/openwrt_release
	set -- $(flash)
	tailnet
	tscon=; tsprob=; tsexit=
	if [ -n "$TS_STATE" ]; then
		[ "$TS_STATE" = Running ] && tscon=true || tscon=false
		# Home mode turns --accept-routes off on purpose (monochrome advertises the home LAN), and
		# Tailscale lists that as a health message. It stays in tailnet_health, but isn't a problem.
		echo "$TS_HEALTH" | sed 's/; /\n/g' | grep -v 'advertising routes but --accept-routes is false' | grep -q . && tsprob=true || tsprob=false
		[ "$TS_EXIT" = true ] && tsexit=true || tsexit=false
	fi
	printf '{'
	printf '"temp_cpu":%s,' "$(temp "$(hwmon_temp cpu_thermal)")"
	printf '"temp_wifi_2g":%s,"temp_wifi_5g":%s,' "$(temp "$(wifi_temp 2g)")" "$(temp "$(wifi_temp 5g)")"
	printf '"temp_eth_phy":%s,' "$(temp "$(hwmon_temp 'mdio_bus*')")"
	printf '"fan_rpm":%s,' "$(num "$(fan_rpm)")"
	for b in 2g 5g; do
		printf '"load_%s":%s,"noise_%s":%s,"clients_%s":%s,' \
			$b "$(pct "$(usteer_band $b load)")" $b "$(num "$(usteer_band $b noise)")" $b "$(num "$(usteer_band $b n_assoc)")"
		printf '"tx_retry_pct_%s":%s,"tx_fail_pct_%s":%s,' $b "$(num "$(tx_pct $b retries)")" $b "$(num "$(tx_pct $b failed)")"
	done
	printf '"roams_in":%s,"roams_out":%s,' "$(num "$(usteer_roams target)")" "$(num "$(usteer_roams source)")"
	printf '"weak_client_count":%s,"weakest_dbm":%s,"weak_macs":%s,' "$(num "$weak")" "$(num "$weakest")" "$(str "$weakmacs")"
	printf '"uplink_mbps":%s,"uplink_flaps":%s,' "$(num "$(cat "/sys/class/net/$up/speed" 2>/dev/null)")" "$(num "$(cat "/sys/class/net/$up/carrier_changes" 2>/dev/null)")"
	printf '"roam_peers":%s,"lldp_neighbors":%s,' "$(num "$(usteer_peers)")" "$(str "$(lldp_neighbors)")"
	printf '"flash_free_mb":%s,"flash_usage_pct":%s,' "$(num "${1:-}")" "$(num "${2:-}")"
	printf '"tailnet_connected":%s,"tailnet_state":%s,"tailnet_ip":%s,"tailnet_peers_online":%s,' \
		"$(bool "$tscon")" "$(str "$TS_STATE")" "$(str "$TS_IP")" "$(num "$([ -n "$TS_STATE" ] && echo "$TS_PEERS")")"
	printf '"tailnet_problem":%s,"tailnet_health":%s,"tailnet_exit_node":%s,' "$(bool "$tsprob")" "$(str "$TS_HEALTH")" "$(bool "$tsexit")"
	printf '"mode":%s,"switch":%s,"openwrt_version":%s,' "$(str "$mode")" "$(str "$sw")" "$(str "OpenWrt $DISTRIB_RELEASE")"
	# System, radios and ports (formerly HA's openwrt integration). The station list is written to
	# $CACHE/stations for the stations topic, new-device events and per-device sensors.
	mkdir -p "$CACHE"
	stations > "$CACHE/stations.new"; mv "$CACHE/stations.new" "$CACHE/stations"
	set -- $(cat /proc/loadavg)
	printf '"cpu_usage":%s,"memory_usage":%s,"load":%s,"last_boot":%s,' "$(cpu_pct)" "$(mem_pct)" "$(isnum "$1")" "$(str "$(last_boot)")"
	printf '"ip_address":%s,"public_ip":%s,"reboot_required":%s,' "$(str "$(lan_ip)")" "$(str "$(public_ip)")" "$(reboot_needed)"
	printf '"wifi_clients":%s,"devices_seen":%s,' "$(wc -l < "$CACHE/stations" | tr -d ' ')" "$(num "$(devices_seen | tr -d ' ')")"
	m=$(
		for b in 2g 5g; do
			r=$(radio $b); s=; [ -n "$r" ] && s=$(ap_section $b)
			printf '"channel_%s":%s,"wifi_mode_%s":%s,"tx_power_%s":%s,"radio_%s":%s,"ssid_%s":%s,' \
				$b "$(num "$(live $b channel)")" $b "$(str "$([ -n "$r" ] && uci -q get "wireless.$r.htmode")")" \
				$b "$(num "$(live $b txpower)")" $b "$(uci_on "$r")" $b "$(uci_on "$s")"
		done
		ports | while read -r ifn oid name; do
			printf '"link_%s":%s,' "$oid" "$(bool "$(cat "/sys/class/net/$ifn/carrier" 2>/dev/null)")"
		done
		rates
	)
	printf '%s}\n' "${m%,}"
}

# ---------- discovery ----------
# key|name|unit|device_class|state_class|icon
SENSORS='temp_cpu|CPU temperature|°C|temperature|measurement|
temp_wifi_2g|Wi-Fi 2.4 GHz chip temperature|°C|temperature|measurement|
temp_wifi_5g|Wi-Fi 5 GHz chip temperature|°C|temperature|measurement|
temp_eth_phy|Ethernet PHY temperature|°C|temperature|measurement|
fan_rpm|Fan|rpm||measurement|mdi:fan
load_2g|2.4 GHz channel load|%||measurement|mdi:wifi
load_5g|5 GHz channel load|%||measurement|mdi:wifi
noise_2g|2.4 GHz noise|dBm|signal_strength|measurement|
noise_5g|5 GHz noise|dBm|signal_strength|measurement|
clients_2g|2.4 GHz clients|||measurement|mdi:account-multiple
clients_5g|5 GHz clients|||measurement|mdi:account-multiple
tx_retry_pct_2g|2.4 GHz tx retries (experimental)|%||measurement|mdi:repeat
tx_retry_pct_5g|5 GHz tx retries (experimental)|%||measurement|mdi:repeat
tx_fail_pct_2g|2.4 GHz tx drops (experimental)|%||measurement|mdi:alert-circle-outline
tx_fail_pct_5g|5 GHz tx drops (experimental)|%||measurement|mdi:alert-circle-outline
roams_in|Roams in|||total_increasing|mdi:transfer-down
roams_out|Roams out|||total_increasing|mdi:transfer-up
weak_client_count|Weak clients|||measurement|mdi:wifi-strength-1-alert
weakest_dbm|Weakest client signal|dBm|signal_strength|measurement|
weak_macs|Weak devices (MAC=dBm)||||mdi:wifi-strength-1-alert
uplink_mbps|Uplink speed|Mbit/s|data_rate|measurement|
uplink_flaps|Uplink link changes|||total_increasing|mdi:ethernet-cable-off
roam_peers|Roaming peers|||measurement|mdi:access-point-network
lldp_neighbors|LLDP/CDP neighbours||||mdi:switch
mode|Mode||||mdi:airplane-cog
switch|Side switch position||||mdi:toggle-switch-outline
openwrt_version|OpenWrt version||||mdi:package-variant
flash_free_mb|Flash free|MB|data_size|measurement|mdi:harddisk
flash_usage_pct|Flash used|%||measurement|mdi:harddisk'
# Tailscale (only where it's installed: the Beryl). Keys say "tailnet" because HA's old
# openwrt-integration Tailscale entities still own the beryl_tailscale_* entity ids.
TS_SENSORS='tailnet_state|Tailscale state||||mdi:vpn
tailnet_ip|Tailscale IP||||mdi:ip-network
tailnet_peers_online|Tailscale peers online|||measurement|mdi:account-network
tailnet_health|Tailscale health messages||||mdi:message-alert-outline'
# key|name|device_class|icon (binary sensors: ON/OFF, unknown when the value is null)
TS_BINARY='tailnet_connected|Tailscale connected|connectivity|
tailnet_problem|Tailscale problem|problem|
tailnet_exit_node|Tailscale exit node in use||mdi:location-exit'
# Keys renamed since the first release (they collided with older SNMP/template entity ids in HA).
# Their retained discovery configs are cleared at startup, which removes the stale entities in HA.
RETIRED='sensor/weak_clients sensor/firmware'

# Entities that replace HA's openwrt (ubus) integration. Their default entity ids are the ones that
# integration used, so once it's removed HA can give these the same ids (and history).
ent() {  # ent COMPONENT OBJECT_ID NAME ',"json":"members"' [ENTITY_ID_PART]: one discovery line on this AP
	printf '%s/%s/%s/%s/config\t{"name":"%s","unique_id":"%s_%s","default_entity_id":"%s.%s_%s"%s,"device":%s}\n' \
		"$DPREFIX" "$1" "$NODE" "$2" "$(esc "$3")" "$NODE" "$2" "$1" "$NODE" "${5:-$2}" "$4" "$dev"
}
st() {  # state-topic members: st KEY [extra members] [value template] [noexpire]
	# (the default template reads value_json.KEY; numbers and switches have no expire_after)
	tpl=$3; [ -n "$tpl" ] || tpl="{{ value_json.$1 }}"
	exp=,\"expire_after\":$((INTERVAL * 3)); [ -n "$4" ] && exp=
	printf ',"state_topic":"%s","value_template":"%s"%s%s' "$STATE_TOPIC" "$tpl" "$exp" "$2"
}
onoff() { printf '{%% if value_json.%s is none %%}None{%% elif value_json.%s %%}ON{%% else %%}OFF{%% endif %%}' "$1" "$1"; }
DIAG=',"entity_category":"diagnostic"'; CONF=',"entity_category":"config"'; MEAS=',"state_class":"measurement"'
parity_discovery() {
	ent sensor cpu_usage "CPU usage" "$(st cpu_usage ',"unit_of_measurement":"%","icon":"mdi:cpu-64-bit"')$MEAS$DIAG"
	ent sensor memory_usage "Memory usage" "$(st memory_usage ',"unit_of_measurement":"%","icon":"mdi:memory"')$MEAS$DIAG"
	ent sensor load "Load" "$(st load ',"icon":"mdi:gauge"')$MEAS$DIAG"
	ent sensor last_boot "Last boot" "$(st last_boot ',"device_class":"timestamp"')$DIAG"
	ent sensor ip_address "IP address" "$(st ip_address ',"icon":"mdi:ip-network"')$DIAG"
	[ -d /etc/beryl-mode ] && ent sensor public_ip "Public IP" "$(st public_ip ',"icon":"mdi:earth"')$DIAG"
	ent sensor wifi_clients "Wi-Fi clients" "$(st wifi_clients ',"icon":"mdi:account-multiple"')$MEAS"
	ent sensor devices_seen "Devices seen" "$(st devices_seen ',"icon":"mdi:lan"')$MEAS"
	ent binary_sensor reboot_required "Reboot required" "$(st reboot_required ',"device_class":"problem","payload_on":"ON","payload_off":"OFF"' "$(onoff reboot_required)")$DIAG"
	ent binary_sensor online "Online" ",\"state_topic\":\"$AVAIL\",\"payload_on\":\"online\",\"payload_off\":\"offline\",\"device_class\":\"connectivity\"$DIAG"
	ssid=
	for b in $(bands); do
		o=$(band_oid $b); n=$(band_name $b)
		ent sensor "${o}_channel" "$n channel" "$(st channel_$b ',"icon":"mdi:wifi"')$DIAG"
		ent sensor "${o}_wifi_mode" "$n Wi-Fi mode" "$(st wifi_mode_$b ',"icon":"mdi:wifi-cog"')$DIAG"
		ent sensor "${o}_traffic_from_clients" "$n traffic from clients" "$(st traffic_ap_${b}_rx ',"unit_of_measurement":"Mbps","icon":"mdi:download-network"')$MEAS"
		ent sensor "${o}_traffic_to_clients" "$n traffic to clients" "$(st traffic_ap_${b}_tx ',"unit_of_measurement":"Mbps","icon":"mdi:upload-network"')$MEAS"
		ent switch "${o}_radio" "$n radio" "$(st radio_$b '' "$(onoff radio_$b)" noexpire),\"command_topic\":\"${SETP}radio_$b\",\"payload_on\":\"ON\",\"payload_off\":\"OFF\",\"state_on\":\"ON\",\"state_off\":\"OFF\",\"icon\":\"mdi:radio-tower\"$CONF"
		s=$(ap_section $b)
		if [ -n "$s" ]; then
			ssid=$(uci -q get "wireless.$s.ssid"); slug=$(echo "$ssid" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_' | sed 's/__*/_/g; s/^_//; s/_$//')
			ent switch "ssid_$b" "${ssid:-Wi-Fi} $n" "$(st ssid_$b '' "$(onoff ssid_$b)" noexpire),\"command_topic\":\"${SETP}ssid_$b\",\"payload_on\":\"ON\",\"payload_off\":\"OFF\",\"state_on\":\"ON\",\"state_off\":\"OFF\",\"icon\":\"mdi:wifi\"$CONF" "${slug:-wifi}_$o"
		fi
		max=$(txpower_max $b)
		ent number "${o}_transmit_power" "$n transmit power" "$(st tx_power_$b ',"unit_of_measurement":"dBm","icon":"mdi:signal"' '' noexpire),\"command_topic\":\"${SETP}tx_power_$b\",\"min\":1,\"max\":${max:-30},\"step\":1,\"mode\":\"box\"$CONF"
	done
	ports | while read -r ifn oid name; do
		ent sensor "${oid}_traffic_in" "$name traffic in" "$(st traffic_port_${oid}_rx ',"unit_of_measurement":"Mbps","icon":"mdi:download-network"')$MEAS"
		ent sensor "${oid}_traffic_out" "$name traffic out" "$(st traffic_port_${oid}_tx ',"unit_of_measurement":"Mbps","icon":"mdi:upload-network"')$MEAS"
		ent binary_sensor "${oid}_link" "$name link" "$(st link_$oid ',"device_class":"connectivity","payload_on":"ON","payload_off":"OFF"' "$(onoff link_$oid)")"
	done
	if command -v tailscale >/dev/null 2>&1; then
		ent sensor tailscale_traffic_in "Tailscale traffic in" "$(st traffic_tailscale_rx ',"unit_of_measurement":"Mbps","icon":"mdi:download-network"')$MEAS"
		ent sensor tailscale_traffic_out "Tailscale traffic out" "$(st traffic_tailscale_tx ',"unit_of_measurement":"Mbps","icon":"mdi:upload-network"')$MEAS"
	fi
	sx=$((INTERVAL * 15))   # /system is published every 5 cycles
	ent sensor system_log "System log" ",\"state_topic\":\"$SYS_TOPIC\",\"value_template\":\"{{ value_json.log_last }}\",\"json_attributes_topic\":\"$SYS_TOPIC\",\"json_attributes_template\":\"{{ {'logs': value_json.logs} | tojson }}\",\"expire_after\":$sx,\"icon\":\"mdi:text-box-outline\"$DIAG"
	ent sensor top_processes "Processes" ",\"state_topic\":\"$SYS_TOPIC\",\"value_template\":\"{{ value_json.process_count }}\",\"json_attributes_topic\":\"$SYS_TOPIC\",\"json_attributes_template\":\"{{ {'top': value_json.processes} | tojson }}\",\"expire_after\":$sx,\"icon\":\"mdi:format-list-numbered\"$MEAS$DIAG"
	ent button reboot "Reboot" ",\"command_topic\":\"${BTNP}reboot\",\"payload_press\":\"PRESS\",\"device_class\":\"restart\"$CONF"
	ent button restart_networking "Restart networking" ",\"command_topic\":\"${BTNP}restart_networking\",\"payload_press\":\"PRESS\",\"icon\":\"mdi:lan-pending\"$CONF"
	ent button restart_wifi "Restart Wi-Fi" ",\"command_topic\":\"${BTNP}restart_wifi\",\"payload_press\":\"PRESS\",\"icon\":\"mdi:wifi-refresh\"$CONF"
	ent event new_device "New device" ",\"state_topic\":\"$EVENT_TOPIC\",\"event_types\":[\"new_device\"],\"icon\":\"mdi:new-box\""
}
# Per-device Wi-Fi signal and speed (uci station_sensors=1). HA (2026.x) keeps one device per
# integration, so each station gets its own MQTT device, named by its MAC (rename it in HA; both APs'
# sensors land on the same device). Randomized (private) MACs get none, since they change.
station_discovery() {  # stdin: station MACs; prints discovery lines
	q="'"
	while read -r mac; do
		random_mac "$mac" && continue
		id=$(echo "$mac" | tr -d :)
		for k in signal speed; do
			if [ $k = signal ]; then f=signal; nm="Wi-Fi signal"; x=',"unit_of_measurement":"dBm","device_class":"signal_strength"'
			else f=tx_mbps; nm="Wi-Fi speed"; x=',"unit_of_measurement":"Mbps","icon":"mdi:speedometer"'; fi
			printf '%s/sensor/%s/sta_%s_%s/config\t{"name":"%s (%s)","unique_id":"%s_sta_%s_%s","default_entity_id":"sensor.%s_%s_wifi_%s","state_topic":"%s","value_template":"{{ (value_json.get(%s%s%s) or {}).get(%s%s%s) }}","expire_after":%s%s,"state_class":"measurement","entity_category":"diagnostic","device":{"connections":[["mac","%s"]],"name":"%s"}}\n' \
				"$DPREFIX" "$NODE" "$id" "$k" "$nm" "$(esc "$NAME")" "$NODE" "$id" "$k" "$NODE" "$id" "$k" "$STA_TOPIC" \
				"$q" "$mac" "$q" "$q" "$f" "$q" $((INTERVAL * 3)) "$x" "$mac" "$(echo "$mac" | tr a-f A-F)"
		done
	done
}

lan_ip() { ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null; }
discovery() {  # prints "topic<TAB>payload" lines; uses $LANIP (may be empty: then no configuration_url,
	# which HA would reject as "http:///" and drop the whole discovery message)
	model=$(cat /tmp/sysinfo/model 2>/dev/null)
	url=; [ -n "$LANIP" ] && url=$(printf ',"configuration_url":"http://%s/"' "$(esc "$LANIP")")
	dev=$(printf '{"identifiers":["openwrt_ap_%s"],"name":"%s","model":"%s","manufacturer":"%s","sw_version":"%s"%s}' \
		"$NODE" "$(esc "$NAME")" "$(esc "$model")" "$(esc "${model%% *}")" "$(. /etc/openwrt_release; esc "OpenWrt $DISTRIB_RELEASE")" "$url")
	sensors=$SENSORS; command -v tailscale >/dev/null 2>&1 && sensors="$SENSORS
$TS_SENSORS"
	echo "$sensors" | while IFS='|' read -r key name unit dclass sclass icon; do
		extra=
		[ -n "$unit" ] && extra="$extra,\"unit_of_measurement\":\"$unit\""
		[ -n "$dclass" ] && extra="$extra,\"device_class\":\"$dclass\""
		[ -n "$sclass" ] && extra="$extra,\"state_class\":\"$sclass\""
		[ -n "$icon" ] && extra="$extra,\"icon\":\"$icon\""
		printf '%s/sensor/%s/%s/config\t{"name":"%s","unique_id":"%s_%s","default_entity_id":"sensor.%s_%s","state_topic":"%s","value_template":"{{ value_json.%s }}","expire_after":%s%s,"device":%s}\n' \
			"$DPREFIX" "$NODE" "$key" "$name" "$NODE" "$key" "$NODE" "$key" "$STATE_TOPIC" "$key" $((INTERVAL * 3)) "$extra" "$dev"
	done
	if command -v tailscale >/dev/null 2>&1; then
		echo "$TS_BINARY" | while IFS='|' read -r key name dclass icon; do
			extra=
			[ -n "$dclass" ] && extra="$extra,\"device_class\":\"$dclass\""
			[ -n "$icon" ] && extra="$extra,\"icon\":\"$icon\""
			printf '%s/binary_sensor/%s/%s/config\t{"name":"%s","unique_id":"%s_%s","default_entity_id":"binary_sensor.%s_%s","state_topic":"%s","value_template":"{%% if value_json.%s is none %%}None{%% elif value_json.%s %%}ON{%% else %%}OFF{%% endif %%}","payload_on":"ON","payload_off":"OFF","expire_after":%s%s,"device":%s}\n' \
				"$DPREFIX" "$NODE" "$key" "$name" "$NODE" "$key" "$NODE" "$key" "$STATE_TOPIC" "$key" "$key" $((INTERVAL * 3)) "$extra" "$dev"
		done
	fi
	led_list | while read -r slug n; do
		m=$(cat "$LEDD/$n/max_brightness" 2>/dev/null); m=${m:-1}
		modes='["onoff"]'; bs=; [ "$m" -gt 1 ] && { modes='["brightness"]'; bs=",\"brightness_scale\":$m"; }
		effs=$(led_effects "$n" | awk '{ printf "%s\"%s\"", (NR > 1 ? "," : ""), $0 }')
		printf '%s/light/%s/led_%s/config\t{"name":"%s","unique_id":"%s_led_%s","default_entity_id":"light.%s_led_%s","schema":"json","command_topic":"%s/%s/led/%s/set","state_topic":"%s/%s/led/%s/state","supported_color_modes":%s%s,"effect":true,"effect_list":[%s],"icon":"mdi:led-on","device":%s}\n' \
			"$DPREFIX" "$NODE" "$slug" "$(esc "$(led_name "$n")")" "$NODE" "$slug" "$NODE" "$slug" \
			"$TPREFIX" "$NODE" "$slug" "$TPREFIX" "$NODE" "$slug" "$modes" "$bs" "$effs" "$dev"
	done
	parity_discovery
	if command -v ghupdate >/dev/null 2>&1; then
		# Install button only with remote-install (see remote_ok); otherwise read-only.
		cmd=; remote_ok && cmd=$(printf ',"command_topic":"%s/%s/firmware/install","payload_install":"install"' "$TPREFIX" "$NODE")
		printf '%s/update/%s/firmware/config\t{"name":"Firmware","unique_id":"%s_firmware_update","default_entity_id":"update.%s_firmware","state_topic":"%s/%s/firmware","device_class":"firmware"%s,"device":%s}\n' \
			"$DPREFIX" "$NODE" "$NODE" "$NODE" "$TPREFIX" "$NODE" "$cmd" "$dev"
	fi
}

# ---------- publishing ----------
pub() {  # pub TOPIC PAYLOAD [retain]; $PUB_ID overrides the client id (the listener sets its own)
	XDG_CONFIG_HOME=/tmp/ha-mqtt mosquitto_pub ${PUB_ID:+-i "$PUB_ID"} -t "$1" -m "$2" ${3:+-r} -q 1
}
clear_retained() {  # an empty retained message deletes the retained one (and the HA entity, for discovery)
	XDG_CONFIG_HOME=/tmp/ha-mqtt mosquitto_pub -t "$1" -n -r -q 1
}
write_opts() {  # broker options live in a 0600 file, never on the command line (ps would show them)
	mkdir -p /tmp/ha-mqtt; chmod 700 /tmp/ha-mqtt
	umask 077
	port=$(cfg port); port=${port:-1883}
	user=$(cfg username); pass=$(cfg password)
	# The options file holds one "-flag value" per line and can't quote, so reject whitespace.
	case "$(cfg host)$user$pass" in *" "*|*"	"*)
		logger -t ha-mqtt "host, username and password must not contain spaces or tabs"; exit 1 ;; esac
	# Written to a temp file and moved into place: the publisher and the listener both call this.
	# mosquitto_pub and mosquitto_sub each read their own file here; separate client ids, because
	# a second connection with the same id would disconnect the first.
	for c in pub sub; do
		{ echo "-h $(cfg host)"; echo "-p $port"; echo "-i ha-mqtt-$NODE-$c"
		  [ -n "$user" ] && echo "-u $user"; [ -n "$pass" ] && echo "-P $pass"; } > /tmp/ha-mqtt/.mosquitto_$c.$$
		mv /tmp/ha-mqtt/.mosquitto_$c.$$ /tmp/ha-mqtt/mosquitto_$c
	done
}

case "${1:-run}" in
	dry-run)
		CACHE=/tmp/ha-mqtt/dry; mkdir -p "$CACHE"   # own counters: don't disturb the running publisher's
		LANIP=$(lan_ip)
		discovery | sed 's/\t/  /'
		for k in $RETIRED; do echo "$DPREFIX/${k%%/*}/$NODE/${k#*/}/config  (cleared)"; done
		echo "$STATE_TOPIC  $(state)"
		[ "$(cfg station_sensors)" = 1 ] && cut -d' ' -f1 "$CACHE/stations" | station_discovery | sed 's/\t/  /'
		echo "$STA_TOPIC  $(stations_json "$CACHE/stations")"
		echo "$SYS_TOPIC  $(system_json)"
		echo "$AVAIL  online"
		fw=$(firmware_json); [ -n "$fw" ] && echo "$TPREFIX/$NODE/firmware  $fw"
		;;
	run)
		[ "$(cfg enabled)" = 1 ] || { logger -t ha-mqtt "disabled in /etc/config/ha_mqtt"; exit 0; }
		[ -n "$(cfg host)" ] || { logger -t ha-mqtt "no broker host set"; exit 1; }
		command -v mosquitto_pub >/dev/null || { logger -t ha-mqtt "mosquitto_pub not installed"; exit 1; }
		write_opts
		# At boot this starts before DHCP has given the LAN an address: wait for one (up to 2 min).
		i=0; while [ -z "$(lan_ip)" ] && [ $i -lt 120 ]; do sleep 2; i=$((i + 2)); done
		# Discovery and the retired-topic clears are (re)done until they've fully reached the broker:
		# at start, whenever the LAN address changes, and every 30 cycles. Each cycle publishes the
		# state first, and touches discovery only if that worked, so an unreachable broker (e.g. Away
		# without the tailnet) costs one failed connection per cycle, not dozens.
		led_snapshot
		# The listener wakes this loop (SIGUSR1) after a command, so HA sees the change at once.
		SLP=; trap '[ -n "$SLP" ] && kill "$SLP" 2>/dev/null' USR1   # trap first: USR1 untrapped would end us
		echo $$ > /tmp/ha-mqtt/run.pid
		n=0; announced=; need_announce=1; need_clear=1; up=1
		while :; do
			LANIP=$(lan_ip)
			[ "$LANIP" = "$announced" ] || need_announce=1
			[ $((n % 30)) -eq 0 ] && need_announce=1
			if pub "$STATE_TOPIC" "$(state)"; then
				[ "$up" = 1 ] || logger -t ha-mqtt "broker reachable again"
				up=1
				# "online" every cycle: it also undoes the listener's will ("offline") after a blip.
				pub "$AVAIL" online retain
				sys_now=$([ $((n % 5)) -eq 0 ] && echo 1); sta_all=$need_announce
				if [ "$need_clear" = 1 ]; then
					need_clear=0
					for k in $RETIRED; do clear_retained "$DPREFIX/${k%%/*}/$NODE/${k#*/}/config" || need_clear=1; done
				fi
				if [ "$need_announce" = 1 ]; then
					fails=$(discovery | while IFS="$(printf '\t')" read -r t p; do pub "$t" "$p" retain || echo x; done | wc -l)
					if [ "$fails" -eq 0 ]; then need_announce=0; announced=$LANIP
					else logger -t ha-mqtt "$fails discovery messages failed; retrying next cycle"; fi
				fi
				# After discovery, so a new entity's first state isn't sent before HA knows it.
				announce_stations "$sta_all"
				pub "$STA_TOPIC" "$(stations_json "$CACHE/stations")"
				[ -n "$sys_now" ] && pub "$SYS_TOPIC" "$(system_json)"
				new_devices
				fw=$(firmware_json); [ -n "$fw" ] && pub "$TPREFIX/$NODE/firmware" "$fw" retain
				led_publish "$([ "$need_announce" = 0 ] && [ $((n % 30)) -eq 0 ] && echo 1 || echo 0)"
			else
				[ "$up" = 0 ] || logger -t ha-mqtt "publish to the broker failed; retrying every cycle"
				up=0
			fi
			n=$((n + 1)); sleep "$INTERVAL" & SLP=$!; wait "$SLP"; SLP=
		done
		;;
	listen)
		# ---------- commands from Home Assistant ----------
		# Firmware installs: HA's update entity publishes "install" (not retained) to
		# <prefix>/<node>/firmware/install. The payload must match exactly; `ghupdate remote-install`
		# (no arguments) then decides and returns at once: exit 0 = accepted, and it runs detached
		# (a newer signed build for this device only, the inhibit hooks: Beryl Home only, the other AP
		# not down; signature, checksum, sysupgrade -T). Exit 75 = refused (busy or rate-limited).
		# This side adds the same 15-min limit, so a burst of presses doesn't even reach ghupdate.
		# LEDs: HA's lights publish JSON to <prefix>/<node>/led/<slug>/set. Only allow-listed LEDs,
		# only their trigger and brightness files; values are validated (see led_command).
		# Wi-Fi: <prefix>/<node>/set/<radio|ssid|tx_power>_<band> (see wifi_command); buttons:
		# <prefix>/<node>/button/<reboot|restart_networking|restart_wifi> (see button_command).
		# Availability: this subscriber's MQTT will publishes "offline" (retained) when the AP drops
		# off the broker; the publisher sends "online" every cycle.
		# -R skips stale retained messages at connect. Every request is logged (logread -e ha-mqtt).
		[ "$(cfg enabled)" = 1 ] || exit 0
		ro=0; remote_ok && ro=1
		LEDS=$(led_list)
		[ -n "$(cfg host)" ] || { logger -t ha-mqtt "no broker host set"; exit 1; }
		command -v mosquitto_sub >/dev/null || { logger -t ha-mqtt "mosquitto_sub not installed"; exit 1; }
		write_opts
		i=0; while [ -z "$(lan_ip)" ] && [ $i -lt 120 ]; do sleep 2; i=$((i + 2)); done
		led_snapshot
		PUB_ID=ha-mqtt-$NODE-cmd   # own client id: sharing the publisher's would drop one connection
		CMD="$TPREFIX/$NODE/firmware/install"; LEDP="$TPREFIX/$NODE/led/"; LAST=/tmp/ha-mqtt/last-install-request
		set -- -t "${SETP}+" -t "${BTNP}+"
		[ "$ro" = 1 ] && set -- "$@" -t "$CMD"
		[ -n "$LEDS" ] && set -- "$@" -t "${LEDP}+/set"
		logger -t ha-mqtt "listening for Home Assistant commands: Wi-Fi, buttons$([ "$ro" = 1 ] && echo ', firmware installs')$([ -n "$LEDS" ] && echo ", $(echo "$LEDS" | wc -l) LEDs")"
		# procd stops an instance by killing its main process only. A `mosquitto_sub | while` pipeline
		# would outlive that, and an orphaned subscriber with the same client id keeps knocking the new
		# one off the broker, so commands get lost. Hence: clear any leftovers for this node first,
		# read through a FIFO in this shell, and stop our subscriber on TERM.
		for p in $(ps w | grep '[m]osquitto_sub' | grep -F "$TPREFIX/$NODE/" | awk '{ print $1 }'); do kill "$p" 2>/dev/null; done
		F=/tmp/ha-mqtt/commands.fifo; rm -f "$F"; mkfifo -m 600 "$F" || exit 1
		XDG_CONFIG_HOME=/tmp/ha-mqtt mosquitto_sub -v -R -q 1 --will-topic "$AVAIL" --will-payload offline --will-retain --will-qos 1 "$@" > "$F" &
		SUB=$!
		# SIGKILL, not TERM: a clean disconnect would cancel the will, and HA should see "offline" when
		# the AP reboots or the service stops (the publisher's next "online" follows a restart).
		trap 'kill -9 "$SUB" 2>/dev/null; rm -f "$F"; exit 0' TERM INT HUP
		while IFS= read -r line; do
			topic=${line%% *}; msg=; [ "$topic" = "$line" ] || msg=${line#* }
			case "$topic" in
			"$CMD")
				[ "$ro" = 1 ] || continue
				[ "$msg" = install ] || { logger -t ha-mqtt "ignored a firmware command with an unexpected payload"; continue; }
				now=$(date +%s); last=$(cat "$LAST" 2>/dev/null || echo 0)
				if [ $((now - last)) -lt 900 ]; then
					logger -t ha-mqtt "Home Assistant install request ignored: at most one per 15 min"; continue
				fi
				ghupdate remote-install >/dev/null 2>&1; rc=$?
				case $rc in
					0) echo "$now" > "$LAST"; logger -t ha-mqtt "Home Assistant install request accepted by ghupdate (progress: logread -e ghupdate)" ;;
					75) logger -t ha-mqtt "Home Assistant install request refused by ghupdate: busy or rate-limited (logread -e ghupdate)" ;;
					*) logger -t ha-mqtt "Home Assistant install request: ghupdate remote-install failed (exit $rc)" ;;
				esac
				sleep 3; fw=$(firmware_json); [ -n "$fw" ] && pub "$TPREFIX/$NODE/firmware" "$fw" retain
				;;
			"$LEDP"*/set)
				slug=${topic#"$LEDP"}; slug=${slug%/set}
				case "$slug" in '' | */* | *[!a-z0-9_]*) logger -t ha-mqtt "ignored an LED command on a bad topic"; continue ;; esac
				led_command "$slug" "$msg"
				;;
			"$SETP"*)
				wifi_command "${topic#"$SETP"}" "$msg"
				;;
			"$BTNP"*)
				button_command "${topic#"$BTNP"}" "$msg"
				;;
			esac
		done < "$F"
		kill "$SUB" 2>/dev/null; rm -f "$F"
		logger -t ha-mqtt "command subscription ended; procd restarts it"
		exit 1
		;;
	*) echo "usage: ha-mqtt run | dry-run | listen" >&2; exit 2 ;;
esac
