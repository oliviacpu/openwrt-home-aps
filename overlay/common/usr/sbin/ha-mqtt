#!/bin/sh
# ha-mqtt: publish access-point health to Home Assistant over MQTT (HA's native MQTT discovery).
# Shared by the Beryl and the Netgear. Settings come from /etc/config/ha_mqtt; the broker credentials
# live only on the device. Bands are found through netifd and phy capabilities, so ifnames don't matter.
#
#   ha-mqtt run        loop forever (procd: /etc/init.d/ha-mqtt)
#   ha-mqtt dry-run    print the discovery configs and one state message, publish nothing
#
# Every sensor reads one key from a single JSON state topic, and has expire_after = 3 intervals.
# Missing or implausible data (no 5 GHz AP, no fan, a sensor that isn't ready) is published as null
# and shows as unknown in HA.

cfg() { uci -q get "ha_mqtt.main.$1"; }
INTERVAL=$(cfg interval); INTERVAL=${INTERVAL:-60}
DPREFIX=$(cfg discovery_prefix); DPREFIX=${DPREFIX:-homeassistant}
TPREFIX=$(cfg topic_prefix); TPREFIX=${TPREFIX:-openwrt-ap}
HOST_NAME=$(uci -q get system.@system[0].hostname)
NAME=$(cfg name); NAME=${NAME:-$HOST_NAME}
NODE=$(cfg node_id); NODE=${NODE:-$(echo "$NAME" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '_' | sed 's/__*/_/g; s/^_//; s/_$//')}
STATE_TOPIC="$TPREFIX/$NODE/state"

# ---------- helpers ----------
num() { [ -n "$1" ] && echo "$1" || echo null; }                # JSON number or null
# mt7915 hwmon reads 0-1 degC until the radio's sensor is ready, so only 10-130 degC counts as real.
temp() { awk -v t="$1" 'BEGIN { if (t ~ /^-?[0-9.]+$/ && t + 0 >= 10 && t + 0 <= 130) print t; else print "null" }'; }
# usteer's channel load comes from the channel survey, where mt7915 reports busy time > active time
# (seen: 643490 %), so only an integer 0-100 counts.
pct() { case "$1" in ''|*[!0-9]*) echo null ;; *) [ "$1" -le 100 ] && echo "$1" || echo null ;; esac; }
# JSON-escape: strip control characters, escape \ and ". Needed because some values come off the
# wire (LLDP/CDP names advertised by other devices) and must not be able to break or inject JSON.
esc() { printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
str() { [ -n "$1" ] && printf '"%s"' "$(esc "$1")" || echo null; }   # JSON string or null
milli() { [ -r "$1" ] && awk '{ printf "%.1f", $1 / 1000 }' "$1"; }   # millidegree file -> degrees
radio() { uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.band='$1'$/\1/p" | head -n 1; }
aps() {  # access-point ifnames on band $1 (2g/5g), from netifd
	r=$(radio "$1"); [ -n "$r" ] || return
	ubus call network.wireless status | jsonfilter -e "@.$r.interfaces[@.config.mode=\"ap\"].ifname" 2>/dev/null
}
phy_band() {  # 2g or 5g for a phy (phy0, phy1)
	iw phy "$1" info 2>/dev/null | grep -qE ' 24[0-9]{2}(\.[0-9])? MHz' && echo 2g || echo 5g   # newer iw prints "2412.0 MHz"
}
hwmon_temp() {  # temperature of the hwmon device whose name matches $1
	for h in /sys/class/hwmon/hwmon*; do
		case "$(cat "$h/name" 2>/dev/null)" in $1) milli "$h/temp1_input"; return ;; esac
	done
}
wifi_temp() {  # mt7915-style per-phy hwmon (mt7915_phyN), mapped to band $1
	for h in /sys/class/hwmon/hwmon*; do
		n=$(cat "$h/name" 2>/dev/null)
		case "$n" in *_phy[0-9]) [ "$(phy_band "${n##*_}")" = "$1" ] && { milli "$h/temp1_input"; return; } ;; esac
	done
}
fan_rpm() {
	for h in /sys/class/hwmon/hwmon*; do
		[ "$(cat "$h/name" 2>/dev/null)" = pwmfan ] && { cat "$h/fan1_input"; return; }
	done
}
usteer_band() {  # field $2 (load, noise, n_assoc) of the usteer node on band $1
	ubus call usteer local_info 2>/dev/null | jsonfilter -e '@[*]' 2>/dev/null | while read -r node; do
		f=$(echo "$node" | jsonfilter -e '@.freq' 2>/dev/null); [ -n "$f" ] || continue
		b=5g; [ "$f" -lt 3000 ] && b=2g
		[ "$b" = "$1" ] && { echo "$node" | jsonfilter -e "@.$2" 2>/dev/null; break; }
	done
}
usteer_roams() {  # total roam_events.$1 (source = steered away, target = arrived) across local nodes
	ubus call usteer local_info 2>/dev/null | jsonfilter -e "@[*].roam_events.$1" 2>/dev/null | awk '{ s += $1 } END { if (NR) print s }'
}
tx_pct() {  # percent of tx packets that were retries ($2=retries) or finally dropped ($2=failed), band $1
	# mt76 (mt7915/mt7981/mt7996) counts tx_failed = tx_retries + final drops (mt7915/mac.c, tx-free
	# path), so on those drivers the drops are failed - retries. Other drivers count drops only.
	for i in $(aps "$1"); do
		d=$(readlink "/sys/class/net/$i/device/driver" 2>/dev/null)
		case "${d##*/}" in mt79*|mt76*) mt=1 ;; *) mt=0 ;; esac
		iw dev "$i" station dump 2>/dev/null | awk -v mt=$mt '
			/tx packets:/ { p += $3 } /tx retries:/ { r += $3 } /tx failed:/ { f += $3 }
			END { if (mt) f -= r; if (f < 0) f = 0; print p + 0, r + 0, f + 0 }'
	done | awk -v k="$2" '{ p += $1; r += $2; f += $3 } END { if (p > 0) printf "%.1f", ((k == "retries") ? r : f) * 100 / p }'
}
usteer_peers() {  # distinct remote usteer hosts this AP sees (one host has a node per radio, "<ip>#<node>")
	ubus call usteer remote_info 2>/dev/null | sed -n 's/^[[:space:]]*"\([^"]*#[^"]*\)": {$/\1/p' | cut -d'#' -f1 | sort -u | wc -l
}
lldp_neighbors() {  # every LLDP/CDP neighbour, "<name> <port> (<via>)" joined by "; ". CDP frames are
	# forwarded by plain bridges, so a far device can show up next to the real uplink switch.
	command -v lldpcli >/dev/null 2>&1 || return
	lldpcli -f keyvalue show neighbors 2>/dev/null | awk -F= '
		function flush() { if (name != "") { out = out (out == "" ? "" : "; ") name " " port " (" via ")" } name = port = "" }
		/\.via=/ { flush(); via = $2 } /\.chassis\.name=/ { name = $2 } /\.port\.descr=/ { port = $2 }
		END { flush(); printf "%s", out }'
}
firmware_json() {  # Netgear image updates (ghupdate) for a read-only MQTT update entity
	command -v ghupdate >/dev/null 2>&1 || return
	GHU_SERIAL=; [ -r /etc/ghupdate/build ] && . /etc/ghupdate/build
	eval "$(ghupdate status 2>/dev/null | jsonfilter -e 'ST=@.state' -e 'UA=@.update_available' -e 'LS=@.latest.serial')"
	inst="build ${GHU_SERIAL:-?}"; latest=$inst
	case "$UA" in true|1) [ -n "$LS" ] && latest="build $LS" ;; esac
	printf '{"installed_version":"%s","latest_version":"%s","title":"%s image","release_summary":"ghupdate state: %s"}\n' \
		"$(esc "$inst")" "$(esc "$latest")" "$(esc "$NAME")" "$(esc "${ST:-unknown}")"
}
signals() {  # "dBm MAC" for every station on this AP's access points (same as ha-wifi's stations)
	for i in $(aps 2g) $(aps 5g); do iwinfo "$i" assoclist 2>/dev/null; done |
	awk '/^[0-9A-Fa-f][0-9A-Fa-f]:/ { for (k = 2; k < NF; k++) if ($(k+1) == "dBm") { print $k, $1; break } }'; }
uplink() { for p in lan eth0; do [ -r "/sys/class/net/$p/speed" ] && { echo "$p"; return; }; done; }

# ---------- one state message ----------
state() {
	up=$(uplink)
	# One iwinfo pass feeds all three, so count, weakest and list agree. NF skips the empty line
	# that echo "" prints with no stations (awk would compare "" < -70 as strings: true).
	sig=$(signals)
	weak=$(echo "$sig" | awk 'NF && $1 < -70' | wc -l)
	weakest=$(echo "$sig" | awk 'NF' | sort -n | head -n 1 | cut -d' ' -f1)
	# "MAC=dBm,..." below -70 dBm, weakest first, at most 8 (ha-wifi weaknames' format; 8 x 21 chars
	# fits HA's 255-char state limit). HA's template helpers turn the MACs into device names.
	weakmacs=$(echo "$sig" | awk 'NF && $1 < -70' | sort -n | head -n 8 | awk '{ printf "%s%s=%s", (NR > 1 ? "," : ""), $2, $1 }')
	mode=; [ -r /etc/beryl-mode/current ] && mode=$(cat /etc/beryl-mode/current)
	sw=$(sed -n 's/.*|mode *) in *\([a-z]*\).*/\1/p' /sys/kernel/debug/gpio 2>/dev/null | head -n 1)
	. /etc/openwrt_release
	printf '{'
	printf '"temp_cpu":%s,' "$(temp "$(hwmon_temp cpu_thermal)")"
	printf '"temp_wifi_2g":%s,"temp_wifi_5g":%s,' "$(temp "$(wifi_temp 2g)")" "$(temp "$(wifi_temp 5g)")"
	printf '"temp_eth_phy":%s,' "$(temp "$(hwmon_temp 'mdio_bus*')")"
	printf '"fan_rpm":%s,' "$(num "$(fan_rpm)")"
	for b in 2g 5g; do
		printf '"load_%s":%s,"noise_%s":%s,"clients_%s":%s,' \
			$b "$(pct "$(usteer_band $b load)")" $b "$(num "$(usteer_band $b noise)")" $b "$(num "$(usteer_band $b n_assoc)")"
		printf '"tx_retry_pct_%s":%s,"tx_fail_pct_%s":%s,' $b "$(num "$(tx_pct $b retries)")" $b "$(num "$(tx_pct $b failed)")"
	done
	printf '"roams_in":%s,"roams_out":%s,' "$(num "$(usteer_roams target)")" "$(num "$(usteer_roams source)")"
	printf '"weak_client_count":%s,"weakest_dbm":%s,"weak_macs":%s,' "$(num "$weak")" "$(num "$weakest")" "$(str "$weakmacs")"
	printf '"uplink_mbps":%s,"uplink_flaps":%s,' "$(num "$(cat "/sys/class/net/$up/speed" 2>/dev/null)")" "$(num "$(cat "/sys/class/net/$up/carrier_changes" 2>/dev/null)")"
	printf '"roam_peers":%s,"lldp_neighbors":%s,' "$(num "$(usteer_peers)")" "$(str "$(lldp_neighbors)")"
	printf '"mode":%s,"switch":%s,"openwrt_version":%s' "$(str "$mode")" "$(str "$sw")" "$(str "OpenWrt $DISTRIB_RELEASE")"
	printf '}\n'
}

# ---------- discovery ----------
# key|name|unit|device_class|state_class|icon
SENSORS='temp_cpu|CPU temperature|°C|temperature|measurement|
temp_wifi_2g|Wi-Fi 2.4 GHz chip temperature|°C|temperature|measurement|
temp_wifi_5g|Wi-Fi 5 GHz chip temperature|°C|temperature|measurement|
temp_eth_phy|Ethernet PHY temperature|°C|temperature|measurement|
fan_rpm|Fan|rpm||measurement|mdi:fan
load_2g|2.4 GHz channel load|%||measurement|mdi:wifi
load_5g|5 GHz channel load|%||measurement|mdi:wifi
noise_2g|2.4 GHz noise|dBm|signal_strength|measurement|
noise_5g|5 GHz noise|dBm|signal_strength|measurement|
clients_2g|2.4 GHz clients|||measurement|mdi:account-multiple
clients_5g|5 GHz clients|||measurement|mdi:account-multiple
tx_retry_pct_2g|2.4 GHz tx retries (experimental)|%||measurement|mdi:repeat
tx_retry_pct_5g|5 GHz tx retries (experimental)|%||measurement|mdi:repeat
tx_fail_pct_2g|2.4 GHz tx drops (experimental)|%||measurement|mdi:alert-circle-outline
tx_fail_pct_5g|5 GHz tx drops (experimental)|%||measurement|mdi:alert-circle-outline
roams_in|Roams in|||total_increasing|mdi:transfer-down
roams_out|Roams out|||total_increasing|mdi:transfer-up
weak_client_count|Weak clients|||measurement|mdi:wifi-strength-1-alert
weakest_dbm|Weakest client signal|dBm|signal_strength|measurement|
weak_macs|Weak devices (MAC=dBm)||||mdi:wifi-strength-1-alert
uplink_mbps|Uplink speed|Mbit/s|data_rate|measurement|
uplink_flaps|Uplink link changes|||total_increasing|mdi:ethernet-cable-off
roam_peers|Roaming peers|||measurement|mdi:access-point-network
lldp_neighbors|LLDP/CDP neighbours||||mdi:switch
mode|Mode||||mdi:airplane-cog
switch|Side switch position||||mdi:toggle-switch-outline
openwrt_version|OpenWrt version||||mdi:package-variant'
# Keys renamed since the first release (they collided with older SNMP/template entity ids in HA).
# Their retained discovery configs are cleared at startup, which removes the stale entities in HA.
RETIRED='sensor/weak_clients sensor/firmware'

lan_ip() { ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null; }
discovery() {  # prints "topic<TAB>payload" lines; uses $LANIP (may be empty: then no configuration_url,
	# which HA would reject as "http:///" and drop the whole discovery message)
	model=$(cat /tmp/sysinfo/model 2>/dev/null)
	url=; [ -n "$LANIP" ] && url=$(printf ',"configuration_url":"http://%s/"' "$(esc "$LANIP")")
	dev=$(printf '{"identifiers":["openwrt_ap_%s"],"name":"%s","model":"%s","manufacturer":"%s","sw_version":"%s"%s}' \
		"$NODE" "$(esc "$NAME")" "$(esc "$model")" "$(esc "${model%% *}")" "$(. /etc/openwrt_release; esc "OpenWrt $DISTRIB_RELEASE")" "$url")
	echo "$SENSORS" | while IFS='|' read -r key name unit dclass sclass icon; do
		extra=
		[ -n "$unit" ] && extra="$extra,\"unit_of_measurement\":\"$unit\""
		[ -n "$dclass" ] && extra="$extra,\"device_class\":\"$dclass\""
		[ -n "$sclass" ] && extra="$extra,\"state_class\":\"$sclass\""
		[ -n "$icon" ] && extra="$extra,\"icon\":\"$icon\""
		printf '%s/sensor/%s/%s/config\t{"name":"%s","unique_id":"%s_%s","default_entity_id":"sensor.%s_%s","state_topic":"%s","value_template":"{{ value_json.%s }}","expire_after":%s%s,"device":%s}\n' \
			"$DPREFIX" "$NODE" "$key" "$name" "$NODE" "$key" "$NODE" "$key" "$STATE_TOPIC" "$key" $((INTERVAL * 3)) "$extra" "$dev"
	done
	if command -v ghupdate >/dev/null 2>&1; then  # read-only: no command_topic, so HA can't trigger a flash
		printf '%s/update/%s/firmware/config\t{"name":"Firmware","unique_id":"%s_firmware_update","default_entity_id":"update.%s_firmware","state_topic":"%s/%s/firmware","device_class":"firmware","device":%s}\n' \
			"$DPREFIX" "$NODE" "$NODE" "$NODE" "$TPREFIX" "$NODE" "$dev"
	fi
}

# ---------- publishing ----------
pub() {  # pub TOPIC PAYLOAD [retain]
	XDG_CONFIG_HOME=/tmp/ha-mqtt mosquitto_pub -t "$1" -m "$2" ${3:+-r} -q 1
}
clear_retained() {  # an empty retained message deletes the retained one (and the HA entity, for discovery)
	XDG_CONFIG_HOME=/tmp/ha-mqtt mosquitto_pub -t "$1" -n -r -q 1
}
write_opts() {  # broker options live in a 0600 file, never on the command line (ps would show them)
	mkdir -p /tmp/ha-mqtt; chmod 700 /tmp/ha-mqtt
	umask 077
	port=$(cfg port); port=${port:-1883}
	user=$(cfg username); pass=$(cfg password)
	# The options file holds one "-flag value" per line and can't quote, so reject whitespace.
	case "$(cfg host)$user$pass" in *" "*|*"	"*)
		logger -t ha-mqtt "host, username and password must not contain spaces or tabs"; exit 1 ;; esac
	{ echo "-h $(cfg host)"; echo "-p $port"; echo "-i ha-mqtt-$NODE"
	  [ -n "$user" ] && echo "-u $user"; [ -n "$pass" ] && echo "-P $pass"; } > /tmp/ha-mqtt/mosquitto_pub
}

case "${1:-run}" in
	dry-run)
		LANIP=$(lan_ip)
		discovery | sed 's/\t/  /'
		for k in $RETIRED; do echo "$DPREFIX/${k%%/*}/$NODE/${k#*/}/config  (cleared)"; done
		echo "$STATE_TOPIC  $(state)"
		fw=$(firmware_json); [ -n "$fw" ] && echo "$TPREFIX/$NODE/firmware  $fw"
		;;
	run)
		[ "$(cfg enabled)" = 1 ] || { logger -t ha-mqtt "disabled in /etc/config/ha_mqtt"; exit 0; }
		[ -n "$(cfg host)" ] || { logger -t ha-mqtt "no broker host set"; exit 1; }
		command -v mosquitto_pub >/dev/null || { logger -t ha-mqtt "mosquitto_pub not installed"; exit 1; }
		write_opts
		# At boot this starts before DHCP has given the LAN an address: wait for one (up to 2 min).
		i=0; while [ -z "$(lan_ip)" ] && [ $i -lt 120 ]; do sleep 2; i=$((i + 2)); done
		# Discovery and the retired-topic clears are (re)done until they've fully reached the broker:
		# at start, whenever the LAN address changes, and every 30 cycles. Each cycle publishes the
		# state first, and touches discovery only if that worked, so an unreachable broker (e.g. Away
		# without the tailnet) costs one failed connection per cycle, not dozens.
		n=0; announced=; need_announce=1; need_clear=1; up=1
		while :; do
			LANIP=$(lan_ip)
			[ "$LANIP" = "$announced" ] || need_announce=1
			[ $((n % 30)) -eq 0 ] && need_announce=1
			if pub "$STATE_TOPIC" "$(state)"; then
				[ "$up" = 1 ] || logger -t ha-mqtt "broker reachable again"
				up=1
				if [ "$need_clear" = 1 ]; then
					need_clear=0
					for k in $RETIRED; do clear_retained "$DPREFIX/${k%%/*}/$NODE/${k#*/}/config" || need_clear=1; done
				fi
				if [ "$need_announce" = 1 ]; then
					fails=$(discovery | while IFS="$(printf '\t')" read -r t p; do pub "$t" "$p" retain || echo x; done | wc -l)
					if [ "$fails" -eq 0 ]; then need_announce=0; announced=$LANIP
					else logger -t ha-mqtt "$fails discovery messages failed; retrying next cycle"; fi
				fi
				fw=$(firmware_json); [ -n "$fw" ] && pub "$TPREFIX/$NODE/firmware" "$fw" retain
			else
				[ "$up" = 0 ] || logger -t ha-mqtt "publish to the broker failed; retrying every cycle"
				up=0
			fi
			n=$((n + 1)); sleep "$INTERVAL"
		done
		;;
	*) echo "usage: ha-mqtt run | dry-run" >&2; exit 2 ;;
esac
