# beryl-mode template (home). Installed by the image; /etc/uci-defaults/90-beryl-mode copies it to
# /etc/beryl-mode/home/ on a fresh install and fills in this unit's own ula_prefix, DHCP DUID and
# br-lan MAC (eth1's, which the home router's .103 reservation is keyed on). No secrets here.
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'dhcp'

config interface 'tailscale'
	option proto 'none'
	option device 'tailscale0'

