#!/bin/sh /etc/rc.common
# Away-mode exit-node gate. Started and stopped by /usr/sbin/beryl-mode, never enabled at boot
# (/etc/init.d/beryl-mode starts it after a reboot in Away).
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/beryl-exitgate run
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/sbin/beryl-exitgate off
}
