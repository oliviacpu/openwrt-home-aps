#!/bin/sh
# CPU busy % since the previous call. snmpd runs this for Home Assistant
# (extend "cpu"); HA polls every 30 s, so each value is a ~30 s average.
read -r _ u n s i w q sq st _ < /proc/stat
t=$((u + n + s + i + w + q + sq + st)); idle=$((i + w))
f=/tmp/cpu-busy.prev
if [ -f "$f" ] && read -r pt pi < "$f" && [ "$t" -gt "$pt" ]; then
  dt=$((t - pt)); busy=$((dt - (idle - pi)))
  echo "$((busy * 100 / dt)).$(( (busy * 1000 / dt) % 10 ))"
else
  echo 0.0
fi
echo "$t $idle" > "$f"
